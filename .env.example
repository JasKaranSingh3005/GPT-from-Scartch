# Backend
GPTLAB_DEVICE=cpu
GPTLAB_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
GPTLAB_TRAINING_ENABLED=true
GPTLAB_MAX_NEW_TOKENS=1000
GPTLAB_MAX_LOADED=3
# Host folder mounted as /data
GPTLAB_DATA_HOST=./outputs
# Frontend (baked in at build time)
VITE_API_URL=http://localhost:8000/api/v1